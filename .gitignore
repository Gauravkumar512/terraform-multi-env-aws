# Local .terraform directories
**/.terraform/*

# Terraform state files — contain resource IDs/IPs, never commit
*.tfstate
*.tfstate.*
terraform.tfstate.d/

# Crash log files
crash.log
crash.*.log

# Ignore override files
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# Ignore CLI configuration files
.terraformrc
terraform.rc
